{
  "name": "vibe-coding-wrapped",
  "version": "0.1.0",
  "description": "Generate a private, static Codex activity report from local session logs.",
  "type": "module",
  "bin": {
    "vibe-wrapped": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "themes",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
